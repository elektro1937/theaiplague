# Copy to .env (never commit .env) or set these in your host's dashboard.

# Required to start and stop matches from the command line
ADMIN_TOKEN=change-me-to-a-long-random-string

# One key per provider. Leave a key empty and that model plays its fallback strategy.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=

# Optional: model ids (defaults are in server/engine.js)
# MODEL_CLAUDE=
# MODEL_CHATGPT=
# MODEL_GEMINI=
# MODEL_GROK=
# MODEL_DEEPSEEK=
# MODEL_LLAMA=
# MODEL_MISTRAL=

# Optional: where the match is saved. Point this at a persistent disk in production.
# SAVE_FILE=server/data/match.json

# Optional: match length in hours (default 24)
# MATCH_HOURS=24
